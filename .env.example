# Project Mode
RAZORPAY_MODE=SIMULATION  # Options: SIMULATION or TEST

# Razorpay Test Mode Credentials (Required for TEST mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# AI / LLM Configuration (Optional, fallback deterministic engine active if omitted)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# Default: SQLite for zero-config local run
DATABASE_URL=sqlite:///./recover_ai.db
# PostgreSQL option: postgresql://postgres:postgres@localhost:5432/recoverai

# Policy Default Thresholds
MAX_AUTOMATIC_RETRIES=2
MAX_AUTOMATIC_RECOVERY_AMOUNT=10000.0
MIN_AI_CONFIDENCE=0.70
